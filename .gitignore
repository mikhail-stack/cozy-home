# Зависимости и сборки (дублируется в frontend/.gitignore и backend/.gitignore
# на случай, если каталоги будут инициализированы как отдельные репозитории)
node_modules/
dist/
.next/
out/

# Playwright (frontend/e2e) — отчёты и артефакты прогонов, не исходники
test-results/
playwright-report/
blob-report/

# Переменные окружения
.env
.env.*.local

# ОС / IDE
.DS_Store
.vscode/*
!.vscode/extensions.json
*.tsbuildinfo

# Docker
docker-compose.override.yml
