# URL бэкенда, доступный из браузера (подставляется в собранный бандл на
# этапе `next build` — после смены значения контейнер нужно пересобрать,
# `docker compose up -d --build`, просто рестарта недостаточно).
# Локально (без Docker) — как ниже. При развёртывании через docker-compose
# backend не имеет собственного порта наружу (см. docker-compose.yml) —
# снаружи до него достаёт только nginx по "/api/" на том же домене/IP, что
# и сам фронтенд, поэтому значение — реальный внешний адрес с "/api", без
# отдельного порта, например http://ваш-домен-или-ip/api.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
