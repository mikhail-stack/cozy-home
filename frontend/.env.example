# URL бэкенда, доступный из браузера
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Ключ Pixabay (без NEXT_PUBLIC_ — используется только на сервере,
# в app/api/pixabay/route.ts) — временный источник фото товаров/Hero
# до подключения загрузки в Cloudinary. Получить: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
