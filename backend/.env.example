# Сервер
PORT=4000
# Публичный адрес фронтенда — источник для CORS (backend/src/app.ts). При
# локальном запуске без Docker — как ниже; при развёртывании через
# docker-compose (на сервере, nginx слушает порт 80 на одном домене/IP на
# оба сервиса) — реальный внешний адрес, например http://ваш-домен-или-ip
# (без порта, если nginx отдаёт на 80-м).
CLIENT_URL=http://localhost:3000

# Без TLS NODE_ENV намеренно НЕ выставлен в production (см.
# docs/architecture.md, раздел 6): production включает Secure-флаг у
# refresh-куки (backend/src/modules/auth/auth.controller.ts) — без HTTPS
# браузер такую куку не вернёт, и пользователей разлогинивало бы каждые
# 15 минут. Когда появится домен и HTTPS — раскомментировать:
# NODE_ENV=production

# База данных. Локально (без Docker) — как ниже, на localhost; внутри
# docker-compose — имя хоста "postgres" (имя сервиса в docker-compose.yml),
# пользователь/пароль/имя базы — те же, что в корневом .env:
# DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cozy_home?schema=public

# JWT — сгенерировать случайные значения перед реальным развёртыванием,
# например: openssl rand -base64 32 (дважды, для каждого секрета отдельно).
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_BOT_USERNAME=CozyHomeBot

# Почта (восстановление пароля)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cozy Home <no-reply@cozyhome.ua>
