generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// В Prisma 7 `url` в datasource-блоке больше не поддерживается — CLI
// (migrate/studio) берёт connection string из prisma.config.ts, а
// PrismaClient в рантайме получает её через driver adapter (см.
// src/lib/prisma.ts). Обнаружено по факту при первом `prisma generate` —
// часть примеров в документации Prisma ещё показывает старый синтаксис.
datasource db {
  provider = "postgresql"
}

// Модели — прямое отражение docs/cozy-home-tz.md, раздел 11, и связей
// из docs/architecture.md, раздел 4. Значения enum'ов (role, category,
// status) — строчными и дословно как в типах фронтенда (auth.store.ts,
// types/product.ts, lib/mock-orders.ts), чтобы Prisma Client отдавал
// строки без маппинга на границе API.

enum Role {
  user
  admin
}

enum ProductCategory {
  candles
  textile
  kitchen
  decor
}

enum OrderStatus {
  new
  processing
  done
  cancelled
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           Role     @default(user)
  // Регистрация (ТЗ, раздел 4.7) его не собирает — только имя/email/пароль;
  // добавляется и меняется в /profile (пункт 23, доработка по решению из
  // чата от 2026-10-04). Не unique: один номер мог бы повторяться у разных
  // аккаунтов (например, при смене владельца номера), в отличие от email.
  phone          String?
  // Уникальный, но не обязательный — привязывается позже, через бота
  // или /profile (docs/cozy-home-tz.md, раздел 7).
  telegramChatId String?  @unique
  createdAt      DateTime @default(now())

  orders             Order[]
  cartItems          CartItem[]
  telegramLinkTokens TelegramLinkToken[]
  passwordResetCodes PasswordResetCode[]
}

model Product {
  id          String          @id @default(cuid())
  name        String
  description String
  // Целое число (гривны без копеек) — везде в ТЗ и моках цены целые
  // (320, 580...), Decimal здесь была бы неоправданным усложнением.
  price       Int
  category    ProductCategory
  // Просто массив URL — фиксированной раскладки main/detail/interior
  // (как временно на фронте в lib/mock-products.ts) в ТЗ нет, это
  // будет решаться на уровне frontend при подключении к этому API
  // (пункт 16 плана: Products-модуль + Cloudinary).
  images      String[]
  inStock     Boolean         @default(true)
  // Остаток на складе. В ТЗ есть только чекбокс «В наличии» (раздел 9), поэтому
  // учёт остатка необязателен: null — не считаем, доступность задаёт один inStock;
  // число — точный учёт: корзина не даёт взять больше остатка, а inStock
  // выводится из него (stock > 0) при записи и при списании со склада.
  stock       Int?
  createdAt   DateTime        @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Order {
  id         String      @id @default(cuid())
  // Сквозной номер для людей — «Заказ #42» в Telegram-уведомлении и колонка
  // «#» в админке (ТЗ, разделы 8–9); id остаётся непредсказуемым cuid.
  number     Int         @unique @default(autoincrement())
  name       String
  phone      String
  comment    String?
  status     OrderStatus @default(new)
  totalPrice Int
  createdAt  DateTime    @default(now())

  // Опционально — по ТЗ регистрация не обязательна для заказа
  // (docs/architecture.md, раздел 4: "заказ гостя создаётся без userId").
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  items OrderItem[]
}

model OrderItem {
  id       String @id @default(cuid())
  quantity Int
  // Цена на момент заказа — снимок, а не ссылка на текущую Product.price,
  // иначе смена цены товара задним числом искажала бы историю заказов.
  price    Int

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

// Только для авторизованных — гостевая корзина целиком в localStorage
// фронтенда и сюда не попадает (docs/cozy-home-tz.md, раздел 5).
model CartItem {
  id       String @id @default(cuid())
  quantity Int

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Один товар — одна строка корзины на пользователя; повторное
  // добавление увеличивает quantity (как addItem в frontend/store/cart.store.ts),
  // а не плодит дубликаты строк.
  @@unique([userId, productId])
}

// Контент страницы «О магазине» (ТЗ, раздел 9): одна строка на весь сайт —
// фиксированный id, создаётся первым сохранением из админки. Пока строки
// нет, API отдаёт значения по умолчанию (modules/about/about.defaults.ts).
// Преимущества (иконка + заголовок + текст) — массив в Json: это часть
// одной страницы, которая всегда читается и пишется целиком.
model About {
  id          String   @id @default("about")
  title       String
  description String
  advantages  Json
  phone       String
  email       String
  updatedAt   DateTime @updatedAt
}

// Одноразовая ссылка привязки Telegram: пользователь в личном кабинете
// получает t.me/<бот>?start=<токен>, бот по /start <токен> сохраняет chat_id
// в User.telegramChatId. В БД лежит только sha256 токена, срок — 15 минут,
// после использования запись удаляется. Привязка по одному лишь email
// (/link email из ТЗ) не делается: любой, кто знает чужой email, привязал бы
// к нему свой Telegram и через восстановление пароля получил бы аккаунт.
model TelegramLinkToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Код восстановления пароля по email (ТЗ, раздел 7 — изначально через
// Telegram; по решению из чата канал заменён на email, формат «код + форма
// нового пароля» сохранён). В БД — только sha256(userId + код), сам код
// шестизначный и живёт 15 минут; у пользователя активен один — новый запрос
// удаляет предыдущий. `attempts` ограничивает подбор кода (перебор всех
// 1 000 000 значений без этого был бы возможен за разумное время).
model PasswordResetCode {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
